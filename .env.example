# Variables must be exported by your shell or hosting provider.
RAF_HOST=127.0.0.1
PORT=8000
RAF_DB=var/raf.sqlite3
RAF_PUBLIC_BOOKS=fatawa-islamiyyah-1708
RAF_REQUESTS_PER_MINUTE=20
# Optional Ollama server, reachable only by the backend.
# Changing model requires importing and evaluating a new release.
RAF_EMBED_URL=
RAF_EMBED_MODEL=
RAF_EMBED_TIMEOUT=15
# local uses the explicitly downloaded ONNX model, no API key.
RAF_EMBED_BACKEND=ollama
RAF_MODEL_DIR=var/models/multilingual-e5-small
